#pragma once

// Copy this file to secrets.h and fill it in. Never commit secrets.h (it is ignored).
// The Wi-Fi password is the only real secret here; the sensor's own token is never in
// a file: it comes from the school when you claim the sensor, and stays on the sensor.

// The Wi-Fi the sensor joins (2.4 GHz; the ESP32 can't see 5 GHz networks).
#define WIFI_SSID "your-2.4-ghz-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Where the sensor sends its reps. The kind of address decides how:
//   "https://<school address>"  a remote server: encrypted, its own login, claimed once
//                               with a code from the athlete's page (type: claim CODE)
//   "http://192.168.4.1"        a local install on the gym's Wi-Fi: plain MQTT on 1883,
//                               no login, a coach links the sensor to a rack
#define SERVER "https://your-school-address"

// Where the sensor asks the time (needed for timestamps, and to check the school's
// certificate). An offline gym Wi-Fi must offer its own time server.
#define NTP_SERVER "pool.ntp.org"
