# ci/local.env — the settings CI runs the backend tests with, as a GYM BOX.
#
# Why this file exists: the tests need a database, a broker and a handful of
# settings, and CI has none of today's .env. These are throwaway values for a
# database that lives for one test run. Nothing here is a secret. The secret key is
# the committed development one on purpose: one test checks that the app notices it.
EA_DEPLOYMENT=local
SECRET_KEY=django-insecure-edgeathlete-dev-key-replace-for-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,basestation,192.168.4.1
POSTGRES_DB=ci
POSTGRES_USER=ci
POSTGRES_PASSWORD=ci-throwaway
MQTT_HOST=mosquitto
MQTT_PORT=1883
