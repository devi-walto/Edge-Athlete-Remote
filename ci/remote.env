# ci/remote.env — the same backend tests, run as a HOSTED installation.
#
# Why this file exists: the gym box and the hosted version are one codebase, so
# every change is tested as both. This differs from local.env only where a hosted
# installation must differ: the mode, debug off, and a named web address. Later
# phases make "remote" refuse to start with debug on or no address, so this file
# is already set the way they will demand. Throwaway values only.
EA_DEPLOYMENT=remote
SECRET_KEY=django-insecure-edgeathlete-dev-key-replace-for-prod
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,edge-athlete.example
POSTGRES_DB=ci
POSTGRES_USER=ci
POSTGRES_PASSWORD=ci-throwaway
MQTT_HOST=mosquitto
MQTT_PORT=1883
