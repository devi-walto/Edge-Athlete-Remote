# edgeathlete-update-clone.service — move the server's copy of the code to the newest
# release (see scripts/remote/update-clone.sh). Started by the timer of the same name.
# Installed by bootstrap.sh into /etc/systemd/system/.
[Unit]
Description=Edge Athlete: keep the server's copy of the code at the newest release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/edgeathlete-update-clone
